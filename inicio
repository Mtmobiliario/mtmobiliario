<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MT Mobiliário | Carpintaria</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Outfit:wght@200;300;400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-warm: #FAF8F5;
      --card-bg: #FFFFFF;
      --primary: #1C1917;
      --secondary: #44403C;
      --muted: #78716C;
      --wood-warm: #A06235;
      --wood-soft: #C89567;
      --wood-light: #F4ECE1;
      --border: #E7E2DA;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg-warm);
      color: var(--primary);
      font-family: 'Outfit', -apple-system, sans-serif;
      font-weight: 300;
      line-height: 1.7;
      letter-spacing: 0.015em;
    }

    h1, h2, h3, .logo {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 300;
      letter-spacing: 0.02em;
    }

    header {
      background: rgba(250, 248, 245, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-wrap {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.3rem 2rem;
    }

    .logo {
      font-size: 1.45rem;
      font-weight: 400;
      color: var(--primary);
      text-decoration: none;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .logo span { color: var(--wood-warm); font-weight: 300; }

    .nav-links { display: flex; gap: 2rem; list-style: none; align-items: center; }
    .nav-links a {
      text-decoration: none;
      color: var(--secondary);
      font-size: 0.88rem;
      font-weight: 400;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: color 0.2s;
    }

    .nav-links a:hover, .nav-links a.active { color: var(--wood-warm); }

    .btn-nav-orcamento {
      background: var(--wood-warm);
      color: white !important;
      padding: 0.65rem 1.3rem;
      border-radius: 2px;
      font-size: 0.8rem !important;
      letter-spacing: 0.08em !important;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    .btn-nav-orcamento:hover { background: #875128 !important; transform: translateY(-2px); }

    /* Botão Menu Hamburguer (Telemóvel) */
    .menu-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.6rem;
      color: var(--primary);
      z-index: 101;
    }

    /* Hero e Carrossel */
    .hero {
      position: relative;
      min-height: 84vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      padding: 5rem 1.5rem;
      overflow: hidden;
      background-color: var(--primary);
    }

    .hero-slider {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .slide {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      transform: translateX(-100%);
      opacity: 0;
      transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1), opacity 1.2s ease;
    }

    .slide.active {
      transform: translateX(0);
      opacity: 1;
      z-index: 2;
    }

    .slide.exit-right {
      transform: translateX(100%);
      opacity: 0;
      z-index: 1;
    }

    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(28, 25, 23, 0.62);
      z-index: 3;
    }

    .hero-content {
      position: relative;
      z-index: 4;
      max-width: 860px;
    }

    .hero-tag {
      display: inline-block;
      background: rgba(200, 149, 103, 0.25);
      border: 1px solid var(--wood-soft);
      color: #F5EBE1;
      padding: 5px 16px;
      border-radius: 30px;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      margin-bottom: 1.5rem;
      font-weight: 400;
    }

    .hero h1 {
      font-size: clamp(2.1rem, 4.8vw, 3.8rem);
      font-weight: 300;
      line-height: 1.18;
      margin-bottom: 1.2rem;
      letter-spacing: 0.02em;
    }

    .hero p {
      font-size: 1.12rem;
      color: #E7E5E4;
      max-width: 660px;
      margin: 0 auto 2.5rem;
      font-weight: 200;
      letter-spacing: 0.02em;
    }

    .hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    .btn-primary, .btn-secondary {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
      position: relative;
      overflow: hidden;
      text-decoration: none;
      padding: 0.95rem 2.2rem;
      border-radius: 2px;
      font-size: 0.82rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: inline-block;
    }

    .btn-primary { background: var(--wood-warm); color: white; }
    .btn-primary:hover, .btn-primary:active { background: #875128 !important; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25); }

    .btn-secondary { background: transparent; color: white; border: 1px solid rgba(255,255,255,0.45); }
    .btn-secondary:hover, .btn-secondary:active { background: rgba(255, 255, 255, 0.15) !important; border-color: rgba(255, 255, 255, 0.8) !important; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2); }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hero-content > * { animation: fadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .hero-tag { animation-delay: 0.1s; }
    .hero h1 { animation-delay: 0.25s; }
    .hero p { animation-delay: 0.4s; }
    .hero-btns { animation-delay: 0.55s; }

    .slider-indicators {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
      display: flex;
      gap: 8px;
    }

    .indicator-dot {
      width: 28px;
      height: 3px;
      background: rgba(255, 255, 255, 0.35);
      border-radius: 2px;
      cursor: pointer;
      transition: background 0.3s, width 0.3s;
    }

    .indicator-dot.active { background: var(--wood-soft); width: 42px; }

    .section-wrap { max-width: 1240px; margin: 0 auto; padding: 6.5rem 2rem; }
    .section-title { text-align: center; margin-bottom: 4rem; }
    .section-title h2 { font-size: clamp(2rem, 3.5vw, 3rem); margin-bottom: 0.6rem; font-weight: 300; }
    .section-title p { color: var(--muted); font-size: 1rem; font-weight: 300; }

    .grid-preview { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; }
    .card-preview { background: var(--card-bg); border: 1px solid var(--border); border-radius: 4px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.03); }
    .card-preview img { width: 100%; height: 280px; object-fit: cover; }
    .card-preview-body { padding: 1.8rem; }
    .card-preview-body small { color: var(--wood-warm); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.08em; font-weight: 500; display: block; margin-bottom: 0.4rem; }
    .card-preview-body h3 { font-size: 1.45rem; font-weight: 400; margin-bottom: 0.6rem; }
    .card-preview-body p { color: var(--muted); font-size: 0.92rem; font-weight: 300; margin-bottom: 1.4rem; }
    
    .btn-explorar {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--wood-warm);
      font-size: 0.82rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    @keyframes pulseArrow {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(5px); }
    }

    .btn-explorar span {
      display: inline-block;
      animation: pulseArrow 1.5s infinite ease-in-out;
    }

    .btn-explorar:hover { color: var(--primary); }

    .cta-banner {
      background: var(--wood-light);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 5.5rem 2rem;
      text-align: center;
    }

    .cta-banner h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); margin-bottom: 1rem; color: var(--primary); font-weight: 300; }
    .cta-banner p { color: var(--secondary); max-width: 600px; margin: 0 auto 2.2rem; font-size: 1.05rem; font-weight: 300; }

    /* Estilo e Animação do Botão Dinâmico */
    .btn-animado-pulsar {
      display: inline-block;
      background: var(--wood-warm);
      color: #ffffff;
      padding: 0.95rem 2.2rem;
      border-radius: 2px;
      font-size: 0.82rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      box-shadow: 0 4px 15px rgba(160, 98, 53, 0.35);
      animation: pulsarBotaoCTA 2s infinite ease-in-out;
      transition: background-color 0.3s ease, transform 0.2s ease;
    }

    .btn-animado-pulsar:hover {
      background: #875128;
      transform: translateY(-3px);
      animation: none;
    }

    @keyframes pulsarBotaoCTA {
      0% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(160, 98, 53, 0.4);
      }
      50% {
        transform: scale(1.03);
        box-shadow: 0 0 0 10px rgba(160, 98, 53, 0);
      }
      100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(160, 98, 53, 0);
      }
    }

    footer { background: var(--primary); color: #D6D3D1; padding: 4.5rem 2rem 2.5rem; }
    .footer-wrap { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 3rem; border-bottom: 1px solid #292524; padding-bottom: 3rem; }
    .footer-col h3 { color: white; font-size: 1.25rem; font-weight: 400; margin-bottom: 1.2rem; letter-spacing: 0.04em; }
    .footer-col p, .footer-col a { color: #A8A29E; font-size: 0.92rem; font-weight: 300; text-decoration: none; line-height: 1.8; display: block; }
    .footer-col a:hover { color: var(--wood-soft); }
    .copyright { text-align: center; padding-top: 2rem; font-size: 0.82rem; color: #78716C; font-weight: 300; }

    /* Responsividade e Menu Telemóvel */
    @media (max-width: 768px) {
      .menu-toggle { display: block; }
      .nav-links {
        position: fixed;
        top: 0;
        right: -100%;
        width: 80%;
        max-width: 320px;
        height: 100vh;
        background: var(--bg-warm);
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        box-shadow: -10px 0 30px rgba(0,0,0,0.15);
        transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 100;
        border-left: 1px solid var(--border);
      }
      .nav-links.active { right: 0; }
      .footer-wrap { grid-template-columns: 1fr; gap: 2.5rem; }
    }

    @media (max-width: 480px) {
      .hero-btns {
        flex-direction: column;
        gap: 0.8rem;
        width: 100%;
        padding: 0 1rem;
      }
      .hero-btns a { width: 100%; text-align: center; }
    }
  </style>
</head>
<body>

  <header>
    <div class="nav-wrap">
      <a href="./index.html" class="logo-container" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <img src="./assets/fotos/logo.png" alt="MT Mobiliário" style="height: 45px; width: auto; object-fit: contain;">
        <span class="logo" style="font-size: 1.15rem; letter-spacing: 0.08em; color: var(--primary); text-transform: uppercase;">MT <span>MOBILIÁRIO</span></span>
      </a>

      <!-- Botão Hamburguer para Telemóveis -->
      <button class="menu-toggle" id="menu-toggle" aria-label="Abrir Menu">
        &#9776;
      </button>

      <ul class="nav-links" id="nav-links">
        <li><a href="./index.html" class="active">Início</a></li>
        <li><a href="./portfolio.html">Portfólio</a></li>
        <li><a href="./sobre.html">Sobre Nós</a></li>
        <li><a href="./contactos.html">Contactos</a></li>
        <li><a href="./orcamento.html" class="btn-nav-orcamento">Pedir Orçamento</a></li>
      </ul>
    </div>
  </header>

  <section class="hero">
    <div class="hero-slider" id="hero-slider">
      <div class="slide active" style="background-image: url('assets/fotos/03.jpg');"></div>
      <div class="slide" style="background-image: url('assets/fotos/04.jpg');"></div>
      <div class="slide" style="background-image: url('assets/fotos/05.jpg');"></div>
      <div class="slide" style="background-image: url('assets/fotos/07.jpg');"></div>
    </div>

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="hero-tag">MT MOBILIÁRIO</span>
      <h1>SOLUÇÕES ÚNICAS PARA ESPAÇOS ÚNICOS</h1>
      <p>Do projeto à instalação, transformamos ideias em realidade, sempre com atenção ao detalhe e às necessidades de cada cliente.</p>
      <div class="hero-btns">
        <a href="./portfolio.html" class="btn-primary">Ver Portfólio</a>
        <a href="./orcamento.html" class="btn-secondary">Pedir Orçamento</a>
      </div>
    </div>

    <div class="slider-indicators" id="slider-indicators"></div>
  </section>

  <section class="section-wrap">
    <div class="section-title">
      <h2>Obras em Destaque</h2>
      <p>Projetos recentemente materializados pela nossa empresa.</p>
    </div>

    <div class="grid-preview" id="destaques-container">
      <p style="text-align: center; grid-column: 1 / -1; color: var(--muted);">A carregar obras em destaque...</p>
    </div>
  </section>

  <section class="cta-banner">
    <h2>Cada espaço tem uma história. Vamos desenhar a sua?</h2>
    <p>Conte-nos a sua ideia ou partilhe as suas medidas. Transformamos conceitos em peças únicas.</p>
    <a href="./orcamento.html" class="btn-animado-pulsar">Solicitar Orçamento Gratuito</a>
  </section>

  <footer>
    <div class="footer-wrap">
      <div class="footer-col">
        <h3>MT Mobiliário | Carpintaria</h3>
        <p>Cada espaço, uma solução à sua medida.</p>
      </div>
      <div class="footer-col">
        <h3>Menu</h3>
        <a href="./portfolio.html">Portfólio de Projetos</a>
        <a href="./sobre.html">Sobre Nós</a>
        <a href="./contactos.html">Contactos Diretos</a>
        <a href="./orcamento.html">Pedir Orçamento</a>
      </div>
      <div class="footer-col">
        <h3>MT MOBILIÁRIO</h3>
        <p>Rua da Aldeia Nova, AP 118, Nº 184, 4595-278 Meixomil, Paços de Ferreira, Distrito do Porto.</p>
        <p>Email: mtmobiliario0@gmail.com</p>
      </div>
    </div>
    <div class="copyright">&copy; 2026 MT Mobiliário | Carpintaria. Todos os direitos reservados.</div>
  </footer>

  <script>
    // Script do Menu Mobile
    const menuToggle = document.getElementById('menu-toggle');
    const navLinks = document.getElementById('nav-links');

    if (menuToggle && navLinks) {
      menuToggle.onclick = () => {
        navLinks.classList.toggle('active');
        menuToggle.innerHTML = navLinks.classList.contains('active') ? '&times;' : '&#9776;';
      };

      // Fechar menu ao clicar num link
      navLinks.querySelectorAll('a').forEach(link => {
        link.onclick = () => {
          navLinks.classList.remove('active');
          menuToggle.innerHTML = '&#9776;';
        };
      });
    }

    // Carrossel deslizante da esquerda para a direita
    const slides = document.querySelectorAll('.slide');
    const indicatorsContainer = document.getElementById('slider-indicators');
    let indiceAtual = 0;
    const duracaoSlide = 5000;
    let timerCarrossel = null;

    if (indicatorsContainer && slides.length > 0) {
      indicatorsContainer.innerHTML = '';
      slides.forEach((_, idx) => {
        const dot = document.createElement('div');
        dot.className = `indicator-dot ${idx === 0 ? 'active' : ''}`;
        dot.onclick = () => {
          mudarParaSlide(idx);
          reiniciarTimer();
        };
        indicatorsContainer.appendChild(dot);
      });
    }

    function mudarParaSlide(novoIndice) {
      if (novoIndice === indiceAtual || slides.length === 0) return;

      const dots = document.querySelectorAll('.indicator-dot');
      const slideSaindo = slides[indiceAtual];
      const slideEntrando = slides[novoIndice];

      slides.forEach((s, idx) => {
        if (idx !== indiceAtual && idx !== novoIndice) {
          s.classList.remove('active', 'exit-right');
        }
      });

      slideSaindo.classList.remove('active');
      slideSaindo.classList.add('exit-right');

      slideEntrando.classList.remove('exit-right');
      slideEntrando.classList.add('active');

      if (dots.length > 0) {
        if (dots[indiceAtual]) dots[indiceAtual].classList.remove('active');
        if (dots[novoIndice]) dots[novoIndice].classList.add('active');
      }

      setTimeout(() => {
        slideSaindo.classList.remove('exit-right');
      }, 1200);

      indiceAtual = novoIndice;
    }

    function proximoSlide() {
      const proximo = (indiceAtual + 1) % slides.length;
      mudarParaSlide(proximo);
    }

    function reiniciarTimer() {
      if (timerCarrossel) clearInterval(timerCarrossel);
      if (slides.length > 1) {
        timerCarrossel = setInterval(proximoSlide, duracaoSlide);
      }
    }

    reiniciarTimer();

    // Carregar Obras em Destaque
    fetch('./portfolio.json')
      .then(res => res.json())
      .then(data => {
        const itens = (data.items || data || []).slice(0, 3);
        const container = document.getElementById('destaques-container');
        if (!container) return;
        container.innerHTML = '';

        itens.forEach(item => {
          let fotoUrl = item.foto || 'https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=800&q=80';
          if (fotoUrl.startsWith('/')) {
            fotoUrl = '.' + fotoUrl;
          }
          const card = document.createElement('div');
          card.className = 'card-preview';
          card.innerHTML = `
            <img src="${fotoUrl}" alt="${item.titulo}">
            <div class="card-preview-body">
              <small>${item.categoria || 'Móvel'}</small>
              <h3>${item.titulo}</h3>
              <p>${item.descricao ? item.descricao.substring(0, 105) + '...' : ''}</p>
              <a href="./portfolio.html" class="btn-explorar">
                Explorar Obra <span>&rarr;</span>
              </a>
            </div>
          `;
          container.appendChild(card);
        });
      })
      .catch(() => {
        const container = document.getElementById('destaques-container');
        if (container) container.innerHTML = '';
      });
  </script>
</body>
</html>
